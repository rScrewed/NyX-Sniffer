{
  "name": "nyx-sniffer",
  "version": "2.1.0",
  "description": "Terminal OSINT tool that collects a Discord user's messages, files and mentions from shared servers and builds a profile in a local browser viewer.",
  "private": true,
  "license": "MIT",
  "author": "rScrewed",
  "type": "commonjs",
  "main": "src/cli/main.js",
  "bin": {
    "nyx": "bin/nyx.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/nyx.js",
    "test": "node --test tests/",
    "lint": "eslint .",
    "build": "node scripts/buildExecutable.js",
    "build:windows": "node scripts/buildExecutable.js --windows"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^30.1.1",
    "postject": "^1.0.0-alpha.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rScrewed/NyX-Sniffer.git"
  },
  "homepage": "https://github.com/rScrewed/NyX-Sniffer",
  "keywords": [
    "osint",
    "discord",
    "cli",
    "viewer"
  ]
}
